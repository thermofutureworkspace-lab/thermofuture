# Opzionale: sovrascrive la config Firebase (su Vercel imposta le stesse chiavi)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Email amministratore (deve coincidere con l’utente in Firebase Auth e con firestore.rules)
# VITE_ADMIN_EMAIL=thermofuture.workspace@gmail.com

# Cloudinary per upload video "Social" da admin.
# IMPORTANTE: non mettere mai API secret nel frontend.
# Crea un upload preset UNSIGNED nel tuo account Cloudinary.
# VITE_CLOUDINARY_CLOUD_NAME=dblar8vw0
# VITE_CLOUDINARY_UPLOAD_PRESET=
